# ==============================================================================
# RESQNET AI — Environment Configuration
# Mode: "demo" (default out-of-the-box synthetic simulation) or "live"
# NOTE: IN "demo" MODE, NO API KEYS OR SUBSCRIPTIONS ARE REQUIRED!
# - All coastal hazard models, A* evacuation routing, and AI Bayesian fusion work instantly.
# - INCOIS QuickSCAT ocean wind stress datasets are ingested locally from data/.
# - Real-time INSAT-3D India satellite imagery streams directly from IMD's open feed.
# - OpenStreetMap natural light tiles & ESRI satellite tiles require NO keys.
# ==============================================================================
DATA_MODE=demo
APP_ENV=development
SECRET_KEY=resqnet-ai-super-secret-key-change-in-production-2025
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# Pilot Region Configuration
DEFAULT_REGION=Puri_Odisha
DEFAULT_LAT=19.8135
DEFAULT_LNG=85.8312

# ------------------------------------------------------------------------------
# Ingestion Providers (Optional in demo mode, required for live mode)
# ------------------------------------------------------------------------------

# 1. IMD (India Meteorological Department)
# Portal: https://mausam.imd.gov.in/
# Note: Live INSAT-3D satellite images (IR1, VIS, WV, CTBT, Animation) stream openly.
IMD_API_KEY=
IMD_API_ENDPOINT=https://api.imd.gov.in/v1

# 2. INCOIS (Indian National Centre for Ocean Information Services)
# Portal: https://incois.gov.in/
# Scatterometer NetCDF dataset (wind speed, wind stress, curl) is parsed locally in data/.
INCOIS_API_KEY=
INCOIS_API_ENDPOINT=https://incois.gov.in/api/v1

# 3. MOSDAC / ISRO (Meteorological & Oceanographic Satellite Data Archival Centre)
# Portal: https://www.mosdac.gov.in/
MOSDAC_API_KEY=
MOSDAC_API_USER=
MOSDAC_ENDPOINT=https://mosdac.gov.in/api

# 4. Copernicus Open Access Hub (Sentinel-1 SAR Satellite Flood Extent)
# Portal: https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# 5. GDELT (Global Database of Events, Language, and Tone - Open Access)
GDELT_ENDPOINT=https://api.gdeltproject.org/api/v2/doc/doc

# 6. Social Media Distress Feeds (Optional)
TWITTER_BEARER_TOKEN=

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL with PostGIS for production, SQLite for local dev)
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./resqnet_spatial.db
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_BACKEND=local
MEDIA_UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15
